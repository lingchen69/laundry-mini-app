/**app.wxss**/ 
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.container {
  padding: 20rpx;
}

.btn-primary {
  background-color: #007AFF;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  text-align: center;
  margin: 10rpx;
  border: none;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}