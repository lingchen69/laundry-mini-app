/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.btn-primary {
  background-color: #007AFF;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  text-align: center;
  margin: 10rpx;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  text-align: center;
  margin: 10rpx;
}
